{
  "name": "server",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon --exec \"node --dns-result-order=ipv4first\" src/index.js",
    "start": "node --dns-result-order=ipv4first src/index.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--dns-result-order=ipv4first node --test test/authorization.test.js",
    "test:concurrency": "cross-env NODE_ENV=test NODE_OPTIONS=--dns-result-order=ipv4first node --env-file=.env --test test/concurrency.test.js",
    "test:all": "cross-env NODE_ENV=test NODE_OPTIONS=--dns-result-order=ipv4first node --env-file=.env --test test/authorization.test.js test/concurrency.test.js",
    "seed": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first prisma db seed",
    "prisma": "prisma"
  },
  "type": "module",
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "nodemon": "3.1.10",
    "prisma": "6.19.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
