{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "declaration": false,
    "sourceMap": true,
    "baseUrl": "src",
    "paths": {
      "@modules/*": ["modules/*"],
      "@middleware/*": ["middleware/*"],
      "@database/*": ["database/*"],
      "@services/*": ["services/*"],
      "@workers/*": ["workers/*"],
      "@tests/*": ["tests/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
