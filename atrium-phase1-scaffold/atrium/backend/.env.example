# --- Database (Neon) ---
# 1. In Neon dashboard -> Connect -> copy the POOLED connection string into DATABASE_URL.
#    (host contains "-pooler", e.g. ep-xxxx-pooler.region.aws.neon.tech)
# 2. Copy the DIRECT (unpooled) connection string into DIRECT_URL.
#    (same host without "-pooler")
# Prisma Migrate needs the direct connection; the running app uses the pooled one.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/atrium_dev?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/atrium_dev?sslmode=require"

# --- Local Postgres fallback (docker run postgres, see README) ---
# DATABASE_URL="postgresql://atrium:atrium@localhost:5432/atrium_dev?schema=public"
# DIRECT_URL="postgresql://atrium:atrium@localhost:5432/atrium_dev?schema=public"

# --- Auth ---
JWT_SECRET="change-me-in-real-env"
JWT_EXPIRES_IN="15m"
BCRYPT_SALT_ROUNDS=10

# --- Server ---
PORT=4000
NODE_ENV=development
INSTANCE_ID=api-1

# --- Paygate (mock payment provider) ---
PAYGATE_SECRET="change-me-webhook-hmac-secret"
PAYGATE_CHAOS=off
PAYGATE_BASE_URL="http://localhost:4001"
PAYGATE_CALLBACK_URL="http://localhost:4000/webhooks/paygate"

# --- Hold / booking rules ---
HOLD_TTL_MINUTES=8
CHECKOUT_MIN_WINDOW_MINUTES=10
BOOKING_MIN_HOURS=1
BOOKING_MAX_HOURS=8
BOOKING_ADVANCE_MIN_HOURS=1
BOOKING_ADVANCE_MAX_DAYS=90
ROOM_BUFFER_MINUTES=15

# --- Logging ---
LOG_LEVEL=info
